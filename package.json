{
  "name": "@onderwijsin/agents",
  "version": "1.0.0",
  "private": true,
  "description": "A collection of provider-agnostic AI plugins and skills for Onderwijs in",
  "keywords": [
    "agents",
    "ai",
    "chatgpt",
    "codex",
    "marketplace",
    "plugins",
    "skills"
  ],
  "license": "MIT",
  "author": {
    "name": "Onderwijs in",
    "email": "hallo@onderwijsin.nl",
    "url": "https://github.com/onderwijsin"
  },
  "contributors": [
    {
      "name": "Remi Huigen",
      "email": "remihuigen@onderwijsin.nl",
      "url": "https://github.com/remihuigen"
    }
  ],
  "repository": "https://github.com/onderwijsin/agents",
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:ts": "oxlint --deny-warnings scripts",
    "lint": "pnpm lint:md && pnpm lint:ts",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "references:sync": "node scripts/sync-references.ts",
    "references:check": "node scripts/sync-references.ts --check",
    "check": "pnpm references:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm validate && pnpm test",
    "test": "tsx --test scripts/*.test.ts",
    "release:prepare": "node scripts/release.ts write",
    "release:check": "node scripts/release.ts check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "consola": "3.4.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.23.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "lint-staged": {
    "*": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
